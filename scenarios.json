{
  "scenarios": [
    {
      "name": "a reimbursement request is visible only to its two parties",
      "members": {
        "requester": "adult",
        "payer": "adult",
        "outsider": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "requester",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, note, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "rb1",
            "{{requester}}",
            "{{payer}}",
            17000,
            "Half the dentist bill",
            "pending",
            "2026-07-19T10:00:00Z",
            "2026-07-19T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "requester",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "rb1"
              }
            ]
          }
        },
        {
          "action": "db",
          "as": "payer",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "rb1"
              }
            ]
          }
        },
        {
          "action": "db",
          "as": "outsider",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements",
          "expect": {
            "status": 200,
            "rowCount": 0
          }
        }
      ]
    },
    {
      "name": "the requester column is forced to the caller — a member cannot open a request in someone else's name",
      "members": {
        "requester": "adult",
        "payer": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "payer",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, note, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "rb-forged",
            "{{requester}}",
            "{{payer}}",
            5000,
            "Claiming to be them",
            "pending",
            "2026-07-19T10:00:00Z",
            "2026-07-19T10:00:00Z"
          ],
          "_comment": "Accepted, but party_scoped's self_column rewrites requester_id to the caller — the forged value never lands.",
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "payer",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements WHERE requester_id = ?",
          "params": [
            "{{requester}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 0
          }
        },
        {
          "action": "db",
          "as": "payer",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements WHERE requester_id = ?",
          "params": [
            "{{payer}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "rb-forged"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "consent cannot be forged: only /api/agree writes the agreement row",
      "members": {
        "requester": "adult",
        "payer": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "requester",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, note, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "rb2",
            "{{requester}}",
            "{{payer}}",
            8000,
            "Soccer registration",
            "pending",
            "2026-07-19T10:00:00Z",
            "2026-07-19T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "requester",
          "sql": "INSERT INTO app_expense_splitter__reimbursement_agreements (id, requester_id, payer_id, requester_agreed, payer_agreed, status, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "rb2",
            "{{requester}}",
            "{{payer}}",
            1,
            1,
            "locked",
            "2026-07-19T10:00:00Z"
          ],
          "expect": {
            "status": 403
          }
        },
        {
          "action": "db",
          "as": "requester",
          "sql": "SELECT id FROM app_expense_splitter__reimbursement_agreements",
          "expect": {
            "status": 200,
            "rowCount": 0
          }
        }
      ]
    },
    {
      "name": "a settled request is frozen: an edit changes nothing",
      "members": {
        "requester": "adult",
        "payer": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "requester",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, note, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
          "params": [
            "rb3",
            "{{requester}}",
            "{{payer}}",
            4200,
            "Field trip",
            "settled",
            "2026-07-19T10:00:00Z",
            "2026-07-19T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "requester",
          "sql": "UPDATE app_expense_splitter__reimbursements SET amount_cents = ? WHERE id = ?",
          "params": [
            999900,
            "rb3"
          ],
          "_comment": "frozen_when freezes by narrowing the WHERE clause, not by erroring: this returns 200 and matches zero rows.",
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "requester",
          "sql": "SELECT id FROM app_expense_splitter__reimbursements WHERE id = ? AND amount_cents = ?",
          "params": [
            "rb3",
            4200
          ],
          "expect": {
            "status": 200,
            "rowCount": 1
          }
        }
      ]
    },
    {
      "name": "a payment handle is readable by everyone, because the person who owes you is the one who needs it",
      "members": {
        "owner": "adult",
        "other": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "db",
          "as": "owner",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES (?, ?, ?, ?, ?)",
          "params": [
            "ph1",
            "{{owner}}",
            "venmo",
            "owner-handle",
            "2026-09-22T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "other",
          "sql": "SELECT member_id, handle FROM app_expense_splitter__payment_handles",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "handle": "owner-handle"
              }
            ]
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT member_id, handle FROM app_expense_splitter__payment_handles",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "handle": "owner-handle"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a forged payment handle is rewritten into the forger's own name, never the victim's",
      "members": {
        "attacker": "adult",
        "victim": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "attacker",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES (?, ?, ?, ?, ?)",
          "params": [
            "ph-forged",
            "{{victim}}",
            "venmo",
            "attacker-handle",
            "2026-09-22T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "victim",
          "sql": "SELECT id FROM app_expense_splitter__payment_handles WHERE member_id = ?",
          "params": [
            "{{victim}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 0
          }
        },
        {
          "action": "db",
          "as": "attacker",
          "sql": "SELECT id FROM app_expense_splitter__payment_handles WHERE id = 'ph-forged' AND member_id = ?",
          "params": [
            "{{attacker}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 1
          }
        }
      ]
    },
    {
      "name": "a member cannot redirect somebody else's payment handle to their own account",
      "members": {
        "victim": "adult",
        "attacker": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES (?, ?, ?, ?, ?)",
          "params": [
            "ph-v",
            "{{victim}}",
            "venmo",
            "victim-handle",
            "2026-09-22T10:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES (?, ?, ?, ?, ?)",
          "params": [
            "ph-a",
            "{{attacker}}",
            "venmo",
            "attacker-own",
            "2026-09-22T10:00:00Z"
          ]
        },
        {
          "action": "db",
          "as": "attacker",
          "sql": "UPDATE app_expense_splitter__payment_handles SET handle = ? WHERE id = ?",
          "params": [
            "attacker-handle",
            "ph-v"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "victim",
          "sql": "SELECT handle FROM app_expense_splitter__payment_handles WHERE id = 'ph-v'",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "handle": "victim-handle"
              }
            ]
          }
        },
        {
          "action": "db",
          "as": "attacker",
          "sql": "UPDATE app_expense_splitter__payment_handles SET handle = ? WHERE id = ?",
          "params": [
            "attacker-new",
            "ph-a"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "attacker",
          "sql": "SELECT handle FROM app_expense_splitter__payment_handles WHERE id = 'ph-a'",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "handle": "attacker-new"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a child's forged payment handle is rewritten the same way",
      "members": {
        "kid": "child",
        "adult": "adult"
      },
      "steps": [
        {
          "action": "db",
          "as": "kid",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES (?, ?, ?, ?, ?)",
          "params": [
            "ph-k",
            "{{adult}}",
            "venmo",
            "kid-handle",
            "2026-09-22T10:00:00Z"
          ],
          "expect": {
            "status": 200
          }
        },
        {
          "action": "db",
          "as": "adult",
          "sql": "SELECT id FROM app_expense_splitter__payment_handles WHERE member_id = ?",
          "params": [
            "{{adult}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 0
          }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id FROM app_expense_splitter__payment_handles WHERE id = 'ph-k' AND member_id = ?",
          "params": [
            "{{kid}}"
          ],
          "expect": {
            "status": 200,
            "rowCount": 1
          }
        }
      ]
    },
    {
