{
  "scenarios": [
    {
      "name": "one pending reimbursement reads as waiting-on-them for the side that confirmed and your-turn for the other",
      "members": {
        "requester": "adult",
        "payer": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, status, created_at, updated_at) VALUES ('es-r', ?, ?, 2500, 'pending', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": [
            "{{requester}}",
            "{{payer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__reimbursement_agreements (id, requester_id, payer_id, requester_agreed, payer_agreed, status, updated_at) VALUES ('es-r', ?, ?, 1, 0, 'pending', '2026-08-01T09:00:00Z')",
          "params": [
            "{{requester}}",
            "{{payer}}"
          ]
        },
        {
          "action": "open",
          "as": "requester"
        },
        {
          "action": "expectVisible",
          "as": "requester",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "click",
          "as": "requester",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "expectVisible",
          "as": "requester",
          "selector": "[data-testid=\"request-card\"][data-request-id=\"es-r\"]"
        },
        {
          "action": "expectCount",
          "as": "requester",
          "selector": "[data-testid=\"confirm-btn\"][data-request-id=\"es-r\"]",
          "count": 0
        },
        {
          "action": "expectText",
          "as": "requester",
          "selector": "[data-testid=\"request-hint\"][data-request-id=\"es-r\"]",
          "text": "Waiting on them"
        },
        {
          "action": "open",
          "as": "payer"
        },
        {
          "action": "expectVisible",
          "as": "payer",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "click",
          "as": "payer",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "expectVisible",
          "as": "payer",
          "selector": "[data-testid=\"request-card\"][data-request-id=\"es-r\"]"
        },
        {
          "action": "expectText",
          "as": "payer",
          "selector": "[data-testid=\"request-hint\"][data-request-id=\"es-r\"]",
          "text": "They confirmed"
        },
        {
          "action": "expectVisible",
          "as": "payer",
          "selector": "[data-testid=\"confirm-btn\"][data-request-id=\"es-r\"]"
        }
      ]
    },
    {
      "name": "the summary tab totals the period's spending by category",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expenses (id, paid_by, amount_cents, description, category, date, split_type, created_at) VALUES (?, ?, ?, ?, ?, ?, 'equal', ?)",
          "params": [
            "es-x1",
            "{{a}}",
            6000,
            "Groceries",
            "food",
            "2026-09-04",
            "2026-09-04T10:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expenses (id, paid_by, amount_cents, description, category, date, split_type, created_at) VALUES (?, ?, ?, ?, ?, ?, 'equal', ?)",
          "params": [
            "es-x2",
            "{{b}}",
            4000,
            "Power bill",
            "utilities",
            "2026-09-20",
            "2026-09-20T10:00:00Z"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expense_splits (id, expense_id, member_id, amount_cents) VALUES (?, ?, ?, ?)",
          "params": [
            "es-s1",
            "es-x1",
            "{{a}}",
            3000
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expense_splits (id, expense_id, member_id, amount_cents) VALUES (?, ?, ?, ?)",
          "params": [
            "es-s2",
            "es-x1",
            "{{b}}",
            3000
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expense_splits (id, expense_id, member_id, amount_cents) VALUES (?, ?, ?, ?)",
          "params": [
            "es-s3",
            "es-x2",
            "{{a}}",
            2000
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__expense_splits (id, expense_id, member_id, amount_cents) VALUES (?, ?, ?, ?)",
          "params": [
            "es-s4",
            "es-x2",
            "{{b}}",
            2000
          ]
        },
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "#tab-summary"
        },
        {
          "action": "expectVisible",
          "as": "a",
          "selector": "[data-testid=\"summary-total\"]"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"summary-count\"]",
          "text": "2 expenses"
        },
        {
          "action": "expectCount",
          "as": "a",
          "selector": "[data-testid=\"summary-category\"]",
          "count": 2
        },
        {
          "action": "expectVisible",
          "as": "a",
          "selector": "[data-testid=\"summary-category\"][data-category=\"food\"]"
        },
        {
          "action": "select",
          "as": "a",
          "selector": "#summary-period",
          "value": "month:2026-09"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"summary-count\"]",
          "text": "2 expenses"
        },
        {
          "action": "select",
          "as": "a",
          "selector": "#summary-period",
          "value": "year:2026"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"summary-count\"]",
          "text": "2 expenses"
        }
      ]
    },
    {
      "name": "the export block offers every report view the hub says this member may render",
      "members": {
        "a": "adult"
      },
      "steps": [
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "#tab-summary"
        },
        {
          "action": "waitFor",
          "as": "a",
          "selector": "[data-testid=\"export-row\"][data-view=\"ledger\"]"
        },
        {
          "action": "expectVisible",
          "as": "a",
          "selector": "[data-testid=\"export-row\"][data-view=\"shares\"]"
        },
        {
          "action": "expectVisible",
          "as": "a",
          "selector": "[data-testid=\"export-row\"][data-view=\"settlements\"]"
        },
        {
          "action": "expectVisible",
          "as": "a",
          "selector": "[data-testid=\"export-row\"][data-view=\"reimbursement_record\"]"
        },
        {
          "action": "expectCount",
          "as": "a",
          "selector": "[data-testid=\"export-row\"]",
          "count": 4
        }
      ]
    },
    {
      "name": "picking shares reweights the split without touching the amount",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "#add-btn"
        },
        {
          "action": "fill",
          "as": "a",
          "selector": "#f-amount",
          "value": "90"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "[data-action=\"setSplitMethod\"][data-method=\"shares\"]"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"weight-total\"]",
          "text": "2 shares in total"
        },
        {
          "action": "fill",
          "as": "a",
          "selector": ".custom-row:first-child input[data-input=\"weightInput\"]",
          "value": "3"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"weight-total\"]",
          "text": "4 shares in total"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": ".custom-row:first-child [data-weight-amount]",
          "text": "$67.50"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "[data-action=\"setSplitMethod\"][data-method=\"percent\"]"
        },
        {
          "action": "expectText",
          "as": "a",
          "selector": "[data-testid=\"weight-total\"]",
          "text": "Adds up to 100%"
        }
      ]
    },
    {
      "name": "a countersigned request tells the payer where to send the money",
      "members": {
        "requester": "adult",
        "payer": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__reimbursements (id, requester_id, payer_id, amount_cents, note, status, created_at, updated_at) VALUES ('es-pl', ?, ?, 14000, 'Dentist', 'pending', '2026-09-01T09:00:00Z', '2026-09-01T09:00:00Z')",
          "params": [
            "{{requester}}",
            "{{payer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__reimbursement_agreements (id, requester_id, payer_id, requester_agreed, payer_agreed, amount_cents, note, status, locked_at, updated_at) VALUES ('es-pl', ?, ?, 1, 1, 14000, 'Dentist', 'locked', '2026-09-02T09:00:00Z', '2026-09-02T09:00:00Z')",
          "params": [
            "{{requester}}",
            "{{payer}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__payment_handles (id, member_id, service, handle, updated_at) VALUES ('es-ph', ?, 'venmo', 'pay-me-here', '2026-09-01T09:00:00Z')",
          "params": [
            "{{requester}}"
          ]
        },
        {
          "action": "open",
          "as": "payer"
        },
        {
          "action": "click",
          "as": "payer",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "expectVisible",
          "as": "payer",
          "selector": "[data-testid=\"request-card\"][data-request-id=\"es-pl\"]"
        },
        {
          "action": "expectVisible",
          "as": "payer",
          "selector": "[data-testid=\"pay-link\"]"
        },
        {
          "action": "expectText",
          "as": "payer",
          "selector": "[data-testid=\"pay-link\"]",
          "text": "Pay with Venmo"
        },
        {
          "action": "open",
          "as": "requester"
        },
        {
          "action": "click",
          "as": "requester",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"requests\"]"
        },
        {
          "action": "expectCount",
          "as": "requester",
          "selector": "[data-testid=\"pay-link\"]",
          "count": 0
        }
      ]
    },
