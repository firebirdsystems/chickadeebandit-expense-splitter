    {
      "name": "an expense split by a saved category rule says so, rather than claiming it was equal",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__category_splits (id, category, member_id, percent_bp, updated_at) VALUES ('cr-a', 'health', ?, 7000, '2026-09-01T09:00:00Z')",
          "params": [
            "{{a}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_expense_splitter__category_splits (id, category, member_id, percent_bp, updated_at) VALUES ('cr-b', 'health', ?, 3000, '2026-09-01T09:00:00Z')",
          "params": [
            "{{b}}"
          ]
        },
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "click",
          "as": "a",
          "selector": "#add-btn"
        },
        {
          "action": "fill",
          "as": "a",
          "selector": "#f-amount",
          "value": "100"
        },
        {
          "action": "fill",
          "as": "a",
